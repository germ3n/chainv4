{
  "manifest_version": 3,
  "name": "chainv4 wallet",
  "version": "VERSION",
  "description": "A light wallet for chainv4: keys from a seed phrase, every balance proven by a light client.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "chainv4 wallet", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "sidebar_action": { "default_title": "chainv4 wallet", "default_panel": "index.html", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "background": { "scripts": ["background.js"] },
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "wallet@chainv4",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
