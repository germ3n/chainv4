# A chainv4 node behind nginx: HTTPS for its API, its explorer at / and its wallet at /wallet/.
# tls.sh renders this into conf.d at start, filling in the ${...} below.

# Who a limit counts: each client by its address over HTTPS, and everyone on the onion together, as
# they all come from tor. Empty keys count nothing, which is also what RATE_LIMIT=off makes them.
map $server_port $rate_client {
    8081 "";
    default ${RATE_KEY};
}

map $server_port $rate_onion {
    8081 ${RATE_ONION_KEY};
    default "";
}

limit_req_zone $rate_client zone=api:10m rate=${RATE_API}r/s;
limit_req_zone $rate_client zone=calls:10m rate=${RATE_CALLS}r/s;
limit_req_zone $rate_client zone=ranges:10m rate=${RATE_RANGE}r/s;
limit_req_zone $rate_onion zone=onion:1m rate=${RATE_ONION}r/s;
limit_conn_zone $rate_client zone=conns:10m;
limit_req_status 429;
limit_conn_status 429;

upstream chainv4 {
    server ${NODE_UPSTREAM};
    keepalive 16;
}

server {
    listen 80;
    server_name ${SERVER_NAME};

    # Let's Encrypt's HTTP-01 challenges, answered from certbot's webroot.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host${HTTPS_PORT_SUFFIX}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate /etc/chainv4/tls/fullchain.pem;
    ssl_certificate_key /etc/chainv4/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ${HSTS}

    # The API takes bodies up to 2 MiB: a deploy's code, in hex.
    client_max_body_size 4m;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    include /etc/nginx/chainv4-locations.conf;
}

# The onion's way in, for tor alone: this port is only on compose's own network.
server {
    listen 8081;
    server_name _;
    client_max_body_size 4m;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto http;

    include /etc/nginx/chainv4-locations.conf;
}
