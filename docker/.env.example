# Copy to .env, next to compose.yaml, and set what you need. Everything has a default.

# What docker/compose.sh and docker/pow.sh run it with: docker or podman. Unset, whichever is
# installed, Docker first.
CONTAINER_ENGINE=

# The chain, made on the first start and kept in the chain volume. A docker/config/genesis.json
# replaces these.
CHAIN_CONSENSUS=authority     # pow: anyone mines; authority: one key produces
CHAIN_FINALITY=ffg            # ffg: staked validators vote; authority: signers vote; depth; none
CHAIN_FEES=base-fee           # base-fee, bid or free

# What this node does: auto mines under pow and produces under an authority, and votes under FFG
# and authority finality. Without docker/config/producer.key and validator.key it signs with the
# development key, whose seed is public.
BLOCKS=auto                   # auto, mine, produce or off
VALIDATE=auto                 # auto, on or off
MINE_THREADS=1                # 0 for none, when workers mine for the node
REWARD_TO=
# With docker/config/mining.token (docker/pow.sh token makes one), a mining node takes workers,
# chainv4 worker, on MINING_PORT; this names another token file inside the container instead.
MINING_TOKEN=
POOL=0                        # 1: the mining port runs a pool, paying workers for their shares
POOL_OPEN=0                   # 1: an open pool, which anyone joins with a payout address
MINING_SOLO=0                 # 1: workers may mine alone too, each block they find paying them
MINING_OPEN=0                 # 1: anyone may, without the token, with POOL or MINING_SOLO
MINING_PUBLIC=                # host:port the apps reach the mining port at, when not the API's
# What the node shares of itself with whoever asks its API: public keeps the addresses of its
# peers, workers and itself, and its workers' names; full shares all; minimal its own state alone.
REPORT=public
HIDE=                         # fields to keep on top of it, by commas, such as counters,devices
SHOW=                         # fields to share on top of it, such as peer-addresses
REPORT_TOKEN=                 # a token file shows everything to its bearer: docker/config/report.token by default
# The name every protocol and gossip topic starts with, beside the genesis id: give a chain of
# your own one, so its nodes never mix with another's. Workers and joining nodes give the same.
PROTOCOL=
PEERS=                        # multiaddrs to dial, separated by spaces
BOOTNODES=                    # this node's own bootnodes, beside the chain's, separated by spaces
INDEX_EVENTS=genesis          # genesis, a height, latest-N, or off
INDEX_ADDRESSES=genesis
INDEX_MULTISIGS=on            # on or off: multisigs by their members, for the wallet to list
EXTRA_ARGS=                   # anything else chainv4 takes

# The node's limits, each the flag of its name, in docs/node.md with its bounds. Left empty, each
# keeps chainv4's own default, which is given here after the #.
MEMPOOL_SIZE=                 # 50000 transactions waiting in all
MEMPOOL_PER_SENDER=           # 64 from one sender
MAX_NONCE_GAP=                # 64 nonces past the sender's at the tip
REPLACE_BUMP_PERCENT=         # 10: what a replacement raises both prices by
UNDERPRICED_FOR=              # 32 blocks under the base price, or a time such as 3m
SYNC_BATCH_BYTES=             # 8388608 bytes of blocks an answer to a syncing peer holds
MAX_PEERS_IN=                 # no cap on connections peers dial in with; 1 to 10000
BAN_SCORE=                    # 100: an invalid block weighs 50, a bad signature 10
BAN_WINDOW=                   # 10m that faults add up in
MAX_STRIKES=                  # 10 floods past a peer's share of the backlog before it is cut off
STRIKE_WINDOW=                # 60s that they add up in
TOR_TIMEOUT=                  # 90s a dial through Tor may take
HTTP_RATE=                    # 0: requests a second from one client, beside nginx's RATE_API; 0 counts none
API_MAX_PAGE=                 # each listing's own most, 100 to 1000; 10 to 10000
SUGGEST_MULTIPLIER=           # 2: how many base prices a suggested fee offers
UPDATE_EVERY=                 # 1h between looks for releases
LUA_STATES=                   # 16 Lua states kept ready
LUA_BUILDERS=                 # 2 threads building them
WASM_CACHE_MB=                # 32 MiB of compiled WebAssembly modules
WASM_CACHE_MODULES=           # 1024 of them at most
TUNE=                         # KEY=VALUE,... for --tune, such as sync.headers=512,rpc.batch=200

# HTTPS in front.
TLS_MODE=self-signed          # self-signed, provided (docker/certs), or letsencrypt
SERVER_NAME=localhost         # the domain or address the node is reached at
LETSENCRYPT_EMAIL=            # for letsencrypt, optional: the account's address
LETSENCRYPT_STAGING=0         # 1 tries Let's Encrypt's staging service first

# Requests a second nginx lets each address make, with room for a burst of six seconds' worth: the
# API, and contract calls within it (POST /call and /rpc), which run on the API's one thread. Everyone
# on the onion shares three times the API's. RATE_LIMIT=off turns them off.
RATE_LIMIT=on
RATE_API=30
RATE_CALLS=5

# Ports on the host.
HTTP_PORT=80
HTTPS_PORT=443
P2P_PORT=4001
MINING_PORT=4002              # TCP, for workers

# The atomic swap contract deployed on this chain (contracts/lua/swap.lua), for GET /status to
# name: chainv4 send deploy --lua contracts/lua/swap.lua prints its address.
SWAP_CONTRACT=

# The DEX deployed on this chain (contracts/lua/dex.lua, set up with contracts/lua/lp_token.lua),
# and the EVM DEX's router (DexRouter in contracts/evm/Dex.sol, 0x and 40 hex digits), for
# GET /status to name to the wallet's Trade page.
DEX_CONTRACT=
DEX_ROUTER=
